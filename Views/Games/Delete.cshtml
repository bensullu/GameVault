@model Game
@{
    ViewData["Title"] = $"Delete - {Model.Title}";
}

<h1>Delete Game</h1>

<div class="card" style="border-color:#cc2222;">
    <p class="danger"><strong>Are you sure you want to delete this game?</strong> This will also delete all its reviews. This action cannot be undone.</p>
</div>

<div class="card" style="max-width: 600px;">
    <h2>@Model.Title</h2>
    <table>
        <tr><th style="width:30%;">Studio</th><td>@Model.Studio.Name</td></tr>
        <tr><th>Genre</th><td>@Model.Genre.Name</td></tr>
        <tr><th>Release Date</th><td>@Model.ReleaseDate.ToString("dd MMM yyyy")</td></tr>
        <tr><th>Price</th><td>$@Model.Price</td></tr>
    </table>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="actions">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-action="Index" class="btn">Cancel</a>
        </div>
    </form>
</div>
