@model Game
@{
    ViewData["Title"] = $"Edit - {Model.Title}";
    var platforms = ViewBag.Platforms as List<Platform> ?? new List<Platform>();
    var selectedPlatforms = ViewBag.SelectedPlatforms as List<int> ?? new List<int>();
}

<h1>Edit Game</h1>

<div class="card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row-2">
            <div class="form-group">
                <label asp-for="Title"></label>
                <input asp-for="Title" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price"></label>
                <input asp-for="Price" type="number" step="0.01" min="0" />
                <span asp-validation-for="Price" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="3"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>

        <div class="row-2">
            <div class="form-group">
                <label asp-for="ReleaseDate"></label>
                <input asp-for="ReleaseDate" type="date" />
                <span asp-validation-for="ReleaseDate" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="StudioId"></label>
                <select asp-for="StudioId" asp-items="ViewBag.StudioId"></select>
                <span asp-validation-for="StudioId" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="GenreId"></label>
                <select asp-for="GenreId" asp-items="ViewBag.GenreId"></select>
                <span asp-validation-for="GenreId" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label>Available Platforms</label>
            @foreach (var p in platforms)
            {
                <div class="checkbox-row">
                    <input type="checkbox" name="selectedPlatforms" value="@p.Id" id="plat-@p.Id" checked="@selectedPlatforms.Contains(p.Id)" />
                    <label for="plat-@p.Id">@p.Name</label>
                </div>
            }
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
