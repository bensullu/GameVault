@model PaginatedList<Game>
@{
    ViewData["Title"] = "Browse Games";
    var genres = ViewBag.Genres as List<Genre> ?? new List<Genre>();
    var currentGenre = ViewData["GenreFilter"] as int?;
}

<div style="display:flex;justify-content:space-between;align-items:center;">
    <h1>Games</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Game</a>
</div>

<form asp-action="Index" method="get" class="card">
    <div class="search-bar">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Search title, studio or genre..." />
        <select name="genreId">
            <option value="">All Genres</option>
            @foreach (var g in genres)
            {
                <option value="@g.Id" selected="@(currentGenre == g.Id)">@g.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn">Clear</a>
    </div>
    <div class="muted" style="font-size:0.85rem;">@Model.TotalCount results</div>
</form>

<div style="margin-bottom:1rem;">
    <span class="muted">Sort by:</span>
    <a asp-action="Index" asp-route-sortOrder="@ViewData["TitleSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-genreId="@currentGenre" class="btn btn-sm">Title</a>
    <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-genreId="@currentGenre" class="btn btn-sm">Release Date</a>
    <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-genreId="@currentGenre" class="btn btn-sm">Price</a>
    <a asp-action="Index" asp-route-sortOrder="@ViewData["RatingSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-genreId="@currentGenre" class="btn btn-sm">Rating</a>
</div>

<div class="grid grid-4">
    @foreach (var game in Model)
    {
        var avg = game.Reviews.Any() ? game.Reviews.Average(r => r.Rating) : 0;
        <div class="game-card">
            <h3><a asp-action="Details" asp-route-id="@game.Id">@game.Title</a></h3>
            <div class="meta">
                <a asp-controller="Studios" asp-action="Details" asp-route-id="@game.StudioId">@game.Studio.Name</a>
                &middot;
                <a asp-controller="Genres" asp-action="Details" asp-route-id="@game.GenreId" class="tag">@game.Genre.Name</a>
            </div>
            <div style="margin-bottom:0.5rem;">
                @if (game.Reviews.Any())
                {
                    <span class="rating">★ @avg.ToString("F1")/10</span>
                }
                else
                {
                    <span class="muted" style="font-size:0.85rem;">No reviews</span>
                }
            </div>
            <div style="margin-top:auto;display:flex;justify-content:space-between;align-items:center;">
                <span class="@(game.Price == 0 ? "price price-free" : "price")">@(game.Price == 0 ? "FREE" : $"${game.Price}")</span>
                <span>
                    <a asp-action="Edit" asp-route-id="@game.Id" class="btn btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@game.Id" class="btn btn-sm btn-danger">Delete</a>
                </span>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        <a asp-action="Index" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-genreId="@currentGenre" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn @(!Model.HasPreviousPage ? "disabled" : "")">Previous</a>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-genreId="@currentGenre" asp-route-pageNumber="@i" class="btn @(i == Model.PageIndex ? "btn-primary" : "")">@i</a>
        }
        <a asp-action="Index" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-genreId="@currentGenre" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn @(!Model.HasNextPage ? "disabled" : "")">Next</a>
    </div>
}
