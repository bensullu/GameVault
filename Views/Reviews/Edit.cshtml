@model Review
@{
    ViewData["Title"] = "Edit Review";
}

<h1>Edit Review</h1>

<div class="card" style="max-width: 700px;">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="GameId"></label>
            <select asp-for="GameId" asp-items="ViewBag.Games"></select>
            <span asp-validation-for="GameId" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ReviewerName"></label>
            <input asp-for="ReviewerName" />
            <span asp-validation-for="ReviewerName" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Title">Review Title</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Comment"></label>
            <textarea asp-for="Comment" rows="4"></textarea>
            <span asp-validation-for="Comment" class="field-error"></span>
        </div>

        <div class="row-2">
            <div class="form-group">
                <label asp-for="Rating">Rating (1-10)</label>
                <input asp-for="Rating" type="number" min="1" max="10" />
                <span asp-validation-for="Rating" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Date"></label>
                <input asp-for="Date" type="date" />
            </div>
            <div class="form-group">
                <div class="checkbox-row">
                    <input asp-for="Recommended" type="checkbox" />
                    <label asp-for="Recommended">Recommended</label>
                </div>
            </div>
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-controller="Games" asp-action="Details" asp-route-id="@Model.GameId" class="btn">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
